# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables (Production + Preview).

# Canonical public URL (your custom domain). Falls back to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project (Project Settings → API). Server-side only — never NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared secret the database checks on every RPC (see
# supabase/migrations/20261019120200_server_token_gate.sql). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_RPC_TOKEN=

# Salt for hashing visitor IPs before rate-limiting (IPs are never stored).
IP_HASH_SALT=
