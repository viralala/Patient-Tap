# ============================================================================
# Patient-Tap — backend environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. Nothing here is
# committed. The app runs in DEMO MODE when these are absent (see lib/config.ts)
# and switches to the real backend automatically once they are present.
# See BACKEND_SETUP.md for a step-by-step guide to obtaining each value.
# ============================================================================

# ---- App URL (used for OAuth redirects + share links) ----------------------
# Local dev: http://localhost:3010  (iOS)  /  http://localhost:3020 (android)
# Production: your deployed URL, e.g. https://patient-tap.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ---- Supabase --------------------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used by webhook + service routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----------------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → your endpoint signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Products you create (Pro = Premium ₹999, Clinic = B2B ₹1999)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_CLINIC_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_CLINIC_YEARLY=

# ---- Emergency alerts (optional) -------------------------------------------
# Email via Resend (https://resend.com) — resend.com/api-keys
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
# SMS via Twilio (optional) — console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
